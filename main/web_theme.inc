R"THEME(
:root{color-scheme:dark;--bg:#0c1013;--panel:#191f23;--cyan:#38bdd6;--text:#f2f2ee;--muted:#a5b3b9;--line:#344147;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}*{box-sizing:border-box}body{margin:0}main{max-width:1032px;margin:32px auto;padding:34px 38px 24px;background:var(--panel);border:1px solid var(--cyan);border-radius:5px;box-shadow:0 0 0 7px #151b1f,0 16px 55px #0006}header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:26px}.brand{display:flex;align-items:center;gap:20px}.satellite{width:148px;height:112px;object-fit:contain}h1{font-size:42px;line-height:.95;letter-spacing:-.035em;font-weight:850;margin:0 0 12px}h1 span{color:var(--cyan)}.brand-subtitle{font-size:12px;letter-spacing:.3em;color:var(--muted)}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;color:var(--cyan)}.header-side{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:15px}.edition{font-size:11px;letter-spacing:.17em;color:var(--muted)}nav{display:flex;gap:22px}nav a{text-decoration:none;font-size:13px;color:var(--muted);padding:8px 0;border-bottom:2px solid transparent}nav a[aria-current=page]{color:var(--text);border-color:var(--cyan)}a{color:var(--cyan);text-underline-offset:4px}a:hover{color:#a3eafa}a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid #f2f2ee;outline-offset:4px}p{color:var(--muted);line-height:1.65}h2{font-size:23px;letter-spacing:-.02em;margin:0 0 12px}#badge{font-size:12px;font-weight:700;letter-spacing:.03em;color:var(--muted)}#badge.good{color:#90dfbf}#badge.warn{color:#ffd08b}.clock{background:#080e11;border:5px solid #101619;border-radius:5px;box-shadow:inset 0 0 0 1px #344147;padding:22px 26px;margin-bottom:16px}.clock-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.time{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:clamp(46px,10vw,88px);font-weight:500;line-height:1.25;font-variant-numeric:tabular-nums;letter-spacing:.035em;margin:9px 0;color:#e5f8fa}.clock small{color:var(--muted);font-size:11px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.card{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:21px 20px;min-height:121px;background:#151b1f}.label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:11px}.value{font-size:23px;font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.hint{font-size:11px;color:var(--muted);line-height:1.6;margin-top:8px}footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;margin:22px 0 14px;font-size:11px;color:var(--muted)}#message{font-size:13px;line-height:1.5;color:#ffd08b;margin:0 0 16px}#message:empty{display:none}.footer-note{border-top:1px solid var(--line);padding-top:14px;margin-bottom:0}form{margin:20px 0}fieldset{border:1px solid var(--line);border-radius:3px;margin:24px 0;padding:20px 24px;background:#151b1f}legend{padding:0 10px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--cyan)}label{display:block;font-size:13px;margin:16px 0 8px;color:#d5dfe2}input{width:100%;background:#0c1215;border:1px solid #50616b;border-radius:3px;padding:12px;color:var(--text);font:inherit;font-size:14px;min-height:44px}input:disabled{opacity:.55}input[type=checkbox]{width:18px;min-height:18px;margin:0 8px 0 0;accent-color:var(--cyan);vertical-align:middle}input[type=file]{font-size:12px}button{background:var(--cyan);border:1px solid var(--cyan);border-radius:3px;padding:12px 18px;min-height:44px;color:#071014;font:inherit;font-size:13px;font-weight:700;margin:14px 8px 0 0;cursor:pointer}button:hover{background:#79d9e9}button.secondary{background:transparent;border-color:#50616b;color:var(--text)}button.secondary:hover{background:#29363d}button:disabled{opacity:.5;cursor:wait}.fields{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.warning{padding:12px 16px;border-left:3px solid #d4a969;background:#24221d;color:#e5c99e;font-size:12px}.hidden,[hidden]{display:none!important}#notice{white-space:pre-wrap;color:#91e0ee;line-height:1.6;font-size:13px;min-height:24px}#login{max-width:430px}.settings-intro{max-width:720px}.section-index{font-size:11px;letter-spacing:.15em;color:var(--cyan);margin:20px 0 8px}
@media(max-width:1080px){main{margin:24px}}@media(max-width:680px){main{margin:14px;padding:24px 20px 18px}.satellite{width:104px;height:85px}.brand{gap:12px}h1{font-size:34px}.brand-subtitle{font-size:10px}.edition{display:none}header{gap:12px}.header-side{gap:8px}nav{gap:14px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.clock{padding:18px}.card{padding:18px 15px}.value{font-size:20px}.fields{grid-template-columns:1fr}fieldset{padding:16px}.clock-top{align-items:flex-start}.eyebrow{font-size:10px;letter-spacing:.1em}}
@media(max-width:420px){header{align-items:flex-start;flex-direction:column}.header-side{align-items:flex-start;width:100%}nav{width:100%;gap:24px}.satellite{width:100px;height:80px}.clock-top{flex-direction:column;gap:9px}.time{font-size:42px}.grid{grid-template-columns:1fr 1fr}.value{font-size:18px}.card{padding:16px 12px;min-height:112px}.label{font-size:9px}.hint{font-size:11px}}
)THEME"
